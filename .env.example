# ====================================================================
# JARVIS ENVIRONMENT CONFIGURATION
# ====================================================================
# You must set at least ONE of the API keys below (Gemini/Groq/OpenAI).
# The system will automatically fall back to backups if one fails.

# 1. Google Gemini API Key (Highly Recommended: Free Tier available)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 2. Groq Cloud API Key (Highly Recommended: Free Tier available)
# Get a key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# 3. OpenAI API Key (Paid Tier)
# Get a key from: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ====================================================================
# Common Configurations
# ====================================================================
OPENAI_TEMPERATURE=0.7
JARVIS_USER_NAME=Nihal

# ====================================================================
# Voice Configurations (Layer 2)
# ====================================================================
VOICE_ENABLED=True
# Standard voice is en-GB-RyanNeural (Ryan) or en-GB-SoniaNeural (Sonia)
TTS_VOICE=en-GB-RyanNeural
STT_LANGUAGE=en-US

# ====================================================================
# Persistent Memory Configurations (Layer 3)
# ====================================================================
DB_PATH=memory/jarvis.db
CHROMA_DB_PATH=memory/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ====================================================================
# Web Search & Knowledge Retrieval (Layer 4)
# ====================================================================
TAVILY_API_KEY=
SEARCH_CACHE_TTL_SEC=3600
SEARCH_TIMEOUT_SEC=10
MAX_SEARCH_RESULTS=5



